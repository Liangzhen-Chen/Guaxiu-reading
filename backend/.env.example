# 复制此文件为 .env，填入真实密钥

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/xiugua

# JWT
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Google Books API
GOOGLE_BOOKS_API_KEY=your-key-here

# 微信小程序
WECHAT_APP_ID=your-app-id
WECHAT_APP_SECRET=your-app-secret

# 模型配置 —— ⚠️ 预留切换口
LLM_MODEL=deepseek-v4-flash
LLM_FALLBACK_MODEL=deepseek-v4-pro
VISION_MODEL=paddleocr-vl-1.5
VISION_FALLBACK_MODEL=qwen-vl-plus

# 上下文管理
CONTEXT_MAX_TOKENS=900000
CONTEXT_WINDOW_ROUNDS=20

# 文件
BOOK_STORAGE_PATH=./data/books
MAX_UPLOAD_SIZE_MB=50
