<view class="container">
  <view class="header">朽瓜 Xiugua</view>
  <view class="list">
    <view wx:for="{{books}}" wx:key="id" class="card" bindtap="openBook" data-id="{{item.id}}">
      <view class="title">{{item.title}}</view>
      <view class="meta">{{item.author || '未知'}} · {{item.file_format}}</view>
      <progress percent="{{item.progress_percent}}" stroke-width="3" activeColor="#1d1d1f" backgroundColor="#d2d2d7"/>
      <view class="status">{{item.progress_status === 'not_started' ? '未开始' : item.progress_percent + '%'}}</view>
    </view>
    <view wx:if="{{books.length===0}}" class="empty">书架上还没有书</view>
  </view>
  <view class="actions">
    <button class="btn" bindtap="upload">📄 导入文件</button>
    <button class="btn" bindtap="uploadFromChat">💬 从聊天选择</button>
  </view>
  <button class="btn-login" bindtap="login" wx:if="{{!loggedIn}}">微信登录</button>
</view>
